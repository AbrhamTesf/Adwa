# ---- Gemini Vision (exhibit ID) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Groq (Whisper STT + Llama persona RAG) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---- ElevenLabs (streaming TTS) ----
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID_KIDS=voice_id_kids
ELEVENLABS_VOICE_ID_SCHOLAR=voice_id_scholar
ELEVENLABS_VOICE_ID_ROYAL=voice_id_royal

# ---- Server ----
PORT=8787
CORS_ORIGIN=http://localhost:5173

# ---- Confidence thresholds ----
VISION_CONFIDENCE_THRESHOLD=0.85

# Exhibit returned when Gemini is unavailable (missing key or quota exhausted).
# One of: shotel_sword | menelik_taytu_statue | negarit_drum | embilta | meleket
VISION_FALLBACK_EXHIBIT_ID=embilta

# ---- Saved tour sessions (use a persistent mounted path in production) ----
SESSION_STORE_PATH=./.data/sessions.json

# ---- Analytics MVP ----
ANALYTICS_STORE_PATH=./.data/analytics.json
ANALYTICS_DASHBOARD_ENABLED=false
ANALYTICS_DASHBOARD_PASSWORD=change_me
