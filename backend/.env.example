# ---- Gemini Vision (exhibit ID) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Groq (Whisper STT + Llama persona RAG) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ---- ElevenLabs (streaming TTS) ----
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID_KIDS=voice_id_kids
ELEVENLABS_VOICE_ID_SCHOLAR=voice_id_scholar
ELEVENLABS_VOICE_ID_ROYAL=voice_id_royal

# ---- Server ----
PORT=8787
CORS_ORIGIN=http://localhost:5173

# ---- Confidence thresholds ----
VISION_CONFIDENCE_THRESHOLD=0.85

# Exhibit returned when Gemini is unavailable (missing key or quota exhausted).
# One of: shotel_sword | menelik_taytu_statue | negarit_drum | embilta | meleket
VISION_FALLBACK_EXHIBIT_ID=embilta

# ---- Saved tour sessions (use a persistent mounted path in production) ----
SESSION_STORE_PATH=./.data/sessions.json

# ---- PostgreSQL ----
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://adwa:adwa_dev_password@localhost:5432/adwa_lens?schema=public

# ---- Authentication ----
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cookies are HttpOnly always; Secure is forced on when NODE_ENV=production.
# Set COOKIE_SECURE=true when testing over https (e.g. a tunnel) in dev.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Staff access ----
# This email is promoted to super_admin on sign-up without needing approval.
BOOTSTRAP_ADMIN_EMAIL=
# Shared fallback invitation code for creating the first staff accounts before
# any invitation records exist. Accounts created this way stay pending until
# approved. Leave blank to accept database-issued invitations only.
STAFF_INVITATION_CODE=
# Password for the seeded bootstrap admin; the seed is skipped when unset.
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Rate limiting ----
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
